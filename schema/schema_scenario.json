{
  "$defs": {
    "DisabledTrackPart": {
      "additionalProperties": false,
      "description": "A track part that is unavailable during a time window.",
      "properties": {
        "trackPart": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trackpart"
        },
        "arrival": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        }
      },
      "title": "DisabledTrackPart",
      "type": "object"
    },
    "IncomingTrain": {
      "additionalProperties": false,
      "description": "A train arriving at or already present in the shunting yard.\n\nUsed for both in (arriving) and inStanding (already present) trains.",
      "properties": {
        "entryTrackPart": {
          "title": "Entrytrackpart",
          "type": "integer"
        },
        "firstParkingTrackPart": {
          "title": "Firstparkingtrackpart",
          "type": "integer"
        },
        "arrival": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/IncomingTrainUnit"
          },
          "title": "Members",
          "type": "array"
        },
        "standingIndex": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standingindex"
        }
      },
      "required": [
        "entryTrackPart",
        "firstParkingTrackPart"
      ],
      "title": "IncomingTrain",
      "type": "object"
    },
    "IncomingTrainUnit": {
      "additionalProperties": false,
      "description": "A TrainUnit as part of an incoming train, with its associated tasks.",
      "properties": {
        "trainUnit": {
          "$ref": "#/$defs/TrainUnit"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSpec"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "trainUnit"
      ],
      "title": "IncomingTrainUnit",
      "type": "object"
    },
    "MemberOfStaff": {
      "additionalProperties": false,
      "description": "A human able to perform tasks at the facility.\n\nOptional at the Scenario level; omitted for consumers (e.g. the solver)\nthat do not model staff.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "shifts": {
          "items": {
            "$ref": "#/$defs/TimeInterval"
          },
          "title": "Shifts",
          "type": "array"
        },
        "breakWindows": {
          "items": {
            "$ref": "#/$defs/TimeInterval"
          },
          "title": "Breakwindows",
          "type": "array"
        },
        "breakDuration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breakduration"
        },
        "startLocationId": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startlocationid"
        },
        "endLocationId": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endlocationid"
        },
        "breakLocationId": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Breaklocationid"
        },
        "canMoveTrains": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canmovetrains"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "MemberOfStaff",
      "type": "object"
    },
    "NonServiceTraffic": {
      "additionalProperties": false,
      "description": "Non-service traffic that reserves part of the infrastructure.",
      "properties": {
        "members": {
          "items": {
            "type": "integer"
          },
          "title": "Members",
          "type": "array"
        },
        "arrival": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        }
      },
      "title": "NonServiceTraffic",
      "type": "object"
    },
    "PredefinedTaskType": {
      "enum": [
        "Move",
        "Split",
        "Combine",
        "Wait",
        "Arrive",
        "Exit",
        "StandIn",
        "StandOut",
        "Walking",
        "Break",
        "NonService"
      ],
      "title": "PredefinedTaskType",
      "type": "string"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "description": "A task to be performed on a train unit.\n\nNote: priority has been dropped from the unified schema. It was marked\ndeprecated in the HIP proto and always set to 1 without being read.",
      "properties": {
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "requiredSkills": {
          "items": {
            "type": "string"
          },
          "title": "Requiredskills",
          "type": "array"
        }
      },
      "title": "TaskSpec",
      "type": "object"
    },
    "TaskType": {
      "additionalProperties": false,
      "description": "A task type, either one of the well-known predefined values or a\ncustom string for facility-specific tasks.",
      "properties": {
        "predefined": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredefinedTaskType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "other": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Other"
        }
      },
      "title": "TaskType",
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "description": "A single time interval, with times in seconds since the epoch.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeInterval",
      "type": "object"
    },
    "TrainRequest": {
      "additionalProperties": false,
      "description": "A request for a train to depart from or remain in the shunting yard.\n\nUsed for both out (departing) and outStanding (remaining) trains.",
      "properties": {
        "leaveTrackPart": {
          "title": "Leavetrackpart",
          "type": "integer"
        },
        "lastParkingTrackPart": {
          "title": "Lastparkingtrackpart",
          "type": "integer"
        },
        "arrival": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival"
        },
        "departure": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "trainUnits": {
          "items": {
            "$ref": "#/$defs/TrainUnit"
          },
          "title": "Trainunits",
          "type": "array"
        },
        "standingIndex": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standingindex"
        },
        "canDepartFromAnyTrack": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candepartfromanytrack"
        }
      },
      "required": [
        "leaveTrackPart",
        "lastParkingTrackPart"
      ],
      "title": "TrainRequest",
      "type": "object"
    },
    "TrainUnit": {
      "additionalProperties": false,
      "description": "A combination of carriages that can move independently.\n\ntype_display_name references an entry in Scenario.train_unit_types by\ndisplay_name + carriages. Embedding the full TrainUnitType is intentionally\navoided to prevent redundancy and inconsistency.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "typeDisplayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typedisplayname"
        }
      },
      "title": "TrainUnit",
      "type": "object"
    },
    "TrainUnitType": {
      "additionalProperties": false,
      "description": "A type of train unit, e.g. SLT or SGM.\n\nIdentity is (display_name, carriages): two TrainUnitType instances with\nthe same display name and carriage count are considered the same type.\n\nNote: display_name is the type name only (\"SLT\", \"SGM\", \"VIRM\") and does\nNOT encode carriage count. The old convention of \"SLT4\" / \"SLT6\" is\nreplaced by display_name=\"SLT\" + carriages=4.",
      "properties": {
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "carriages": {
          "title": "Carriages",
          "type": "integer"
        },
        "length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length"
        },
        "reversalDuration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reversalduration"
        },
        "combineDuration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Combineduration"
        },
        "splitDuration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Splitduration"
        },
        "backNormTime": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backnormtime"
        },
        "backAdditionTime": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backadditiontime"
        },
        "travelSpeed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Travelspeed"
        },
        "startUpTime": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startuptime"
        },
        "typePrefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typeprefix"
        },
        "needsLoco": {
          "default": false,
          "title": "Needsloco",
          "type": "boolean"
        },
        "isLoco": {
          "default": false,
          "title": "Isloco",
          "type": "boolean"
        },
        "needsElectricity": {
          "default": false,
          "title": "Needselectricity",
          "type": "boolean"
        },
        "idPrefix": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idprefix"
        }
      },
      "required": [
        "displayName",
        "carriages"
      ],
      "title": "TrainUnitType",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The daily-varying part of the problem specification: which trains\narrive, depart, or remain in the shunting yard.\n\nTODO: decide whether train_unit_types belongs here (normalized, referenced\nby name from TrainUnit) or embedded in each TrainUnit. Current decision:\nhere.",
  "properties": {
    "trainUnitTypes": {
      "items": {
        "$ref": "#/$defs/TrainUnitType"
      },
      "title": "Trainunittypes",
      "type": "array"
    },
    "in": {
      "items": {
        "$ref": "#/$defs/IncomingTrain"
      },
      "title": "In",
      "type": "array"
    },
    "inStanding": {
      "items": {
        "$ref": "#/$defs/IncomingTrain"
      },
      "title": "Instanding",
      "type": "array"
    },
    "out": {
      "items": {
        "$ref": "#/$defs/TrainRequest"
      },
      "title": "Out",
      "type": "array"
    },
    "outStanding": {
      "items": {
        "$ref": "#/$defs/TrainRequest"
      },
      "title": "Outstanding",
      "type": "array"
    },
    "startTime": {
      "title": "Starttime",
      "type": "integer"
    },
    "endTime": {
      "title": "Endtime",
      "type": "integer"
    },
    "nonServiceTraffic": {
      "items": {
        "$ref": "#/$defs/NonServiceTraffic"
      },
      "title": "Nonservicetraffic",
      "type": "array"
    },
    "disabledTrackPart": {
      "items": {
        "$ref": "#/$defs/DisabledTrackPart"
      },
      "title": "Disabledtrackpart",
      "type": "array"
    },
    "workers": {
      "items": {
        "$ref": "#/$defs/MemberOfStaff"
      },
      "title": "Workers",
      "type": "array"
    }
  },
  "required": [
    "startTime",
    "endTime"
  ],
  "title": "Scenario",
  "type": "object"
}